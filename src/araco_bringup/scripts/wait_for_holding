#!/usr/bin/env python3
# Copyright 2026 Araco Hexapod contributors
# SPDX-License-Identifier: MIT

"""Wait for the exact Gate 1 safety readiness state and fail closed."""

from __future__ import annotations

import argparse
import time

from araco_interfaces.msg import SafetyStatus
import rclpy
from rclpy.node import Node
from rclpy.utilities import remove_ros_args


class HoldingWaiter(Node):
    """Observe safety state without issuing a transition request."""

    def __init__(self) -> None:
        super().__init__('wait_for_holding', namespace='araco/bringup')
        self.complete = False
        self.failure = None
        self.latest = None
        self.subscription = self.create_subscription(
            SafetyStatus, '/araco/safety/status', self._status, 10)

    def _status(self, message: SafetyStatus) -> None:
        self.latest = message
        if message.state == message.STATE_MOTION_ENABLED:
            self.failure = 'Gate 1 observed forbidden MOTION_ENABLED state'
        elif message.state == message.STATE_FAULT_HOLD:
            self.failure = (
                f'safety entered FAULT_HOLD reason={message.reason_code} '
                f'fault_mask={message.fault_mask}')
        elif (message.state == message.STATE_HOLDING and
              message.readiness_mask == message.required_readiness_mask == 127):
            self.complete = True


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--timeout', type=float, default=30.0)
    arguments = parser.parse_args(remove_ros_args()[1:])
    rclpy.init()
    node = HoldingWaiter()
    deadline = time.monotonic() + arguments.timeout
    try:
        while not node.complete and node.failure is None and time.monotonic() < deadline:
            rclpy.spin_once(node, timeout_sec=0.1)
        if node.failure is not None:
            node.get_logger().error(node.failure)
            raise SystemExit(2)
        if not node.complete:
            detail = 'no safety status received'
            if node.latest is not None:
                detail = (
                    f'state={node.latest.state} '
                    f'readiness={node.latest.readiness_mask}/'
                    f'{node.latest.required_readiness_mask}')
            node.get_logger().error(
                f'timed out before complete Gate 1 HOLDING readiness: {detail}')
            raise SystemExit(3)
        node.get_logger().info('Gate 1 readiness reached HOLDING without motion enablement')
    except KeyboardInterrupt:
        pass
    finally:
        if rclpy.ok():
            node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
