"""Run Gate 1 through Gate 5 headlessly and preserve complete evidence."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import platform
import shutil
import signal
import subprocess
import tempfile
import time
import xml.etree.ElementTree as ET

from ament_index_python.packages import get_package_share_directory
import yaml

from araco_system_tests.gate1 import classify_launch_log


def _write_json(path, value):
    path.write_text(
        json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + '\n',
        encoding='utf-8')


def _run(command, environment, output, timeout=10):
    started = time.monotonic()
    try:
        completed = subprocess.run(
            command, env=environment, text=True, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, timeout=timeout, check=False)
        outcome = {
            'command': command,
            'return_code': completed.returncode,
            'wall_s': time.monotonic() - started,
            'timed_out': False,
        }
        text = completed.stdout
    except subprocess.TimeoutExpired as error:
        outcome = {
            'command': command,
            'return_code': None,
            'wall_s': time.monotonic() - started,
            'timed_out': True,
        }
        chunks = (error.stdout or b'', error.stderr or b'')
        text = ''.join(
            item.decode('utf-8', errors='replace') if isinstance(item, bytes) else item
            for item in chunks)
    output.write_text(text, encoding='utf-8')
    return outcome, text


def _junit(path, gate, checks, message):
    suite = ET.Element('testsuite', {
        'name': f'araco_gate{gate}',
        'tests': str(len(checks)),
        'failures': str(sum(not value for value in checks.values())),
        'errors': '0',
    })
    for name, passed in checks.items():
        case = ET.SubElement(suite, 'testcase', {
            'classname': f'araco_system_tests.gate{gate}', 'name': name})
        if not passed:
            failure = ET.SubElement(case, 'failure', {'message': message})
            failure.text = message
    ET.ElementTree(suite).write(path, encoding='unicode', xml_declaration=True)


def _environment(command_environment):
    packages = (
        'ros-jazzy-ros-base', 'ros-jazzy-ros-gz', 'ros-jazzy-gz-ros2-control',
        'ros-jazzy-ros2-control', 'ros-jazzy-ros2-controllers',
    )
    versions = subprocess.run(
        ['dpkg-query', '-W', '-f=${Package}=${Version}\\n', *packages],
        text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        check=False).stdout.splitlines()
    revision = subprocess.run(
        ['git', 'rev-parse', 'HEAD'], text=True, stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT, check=False).stdout.strip()
    dirty = subprocess.run(
        ['git', 'status', '--short'], text=True, stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT, check=False).stdout.splitlines()
    return {
        'captured_wall_time': time.strftime('%Y-%m-%dT%H:%M:%S%z'),
        'platform': platform.platform(),
        'python': platform.python_version(),
        'ros_distro': command_environment.get('ROS_DISTRO'),
        'ros_domain_id': command_environment['ROS_DOMAIN_ID'],
        'gz_partition': command_environment['GZ_PARTITION'],
        'package_versions': versions,
        'git_revision': revision,
        'worktree_changes': dirty,
    }


def main():
    """Execute one immutable Gate 1 through Gate 4 evidence run."""
    executable = Path(os.path.basename(__file__)).name
    gate = (
        5 if executable == 'araco_gate5_evidence' else
        4 if executable == 'araco_gate4_evidence' else
        3 if executable == 'araco_gate3_evidence' else
        2 if executable == 'araco_gate2_evidence' else 1)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('output_directory')
    default_profile = (
        'gazebo_gate5_v0' if gate == 5 else
        'gazebo_gate4_v0' if gate == 4 else
        'gazebo_gate3_v0' if gate == 3 else 'gazebo_ci_v0')
    parser.add_argument(
        '--profile', default=default_profile, choices=[default_profile])
    parser.add_argument('--domain-id', type=int)
    parser.add_argument('--case-name', action='append')
    arguments = parser.parse_args()
    if arguments.case_name and gate != 4:
        parser.error('--case-name is available only for Gate 4 diagnostics')
    destination = Path(arguments.output_directory).expanduser().resolve()
    if destination.exists():
        parser.error(f'output directory already exists: {destination}')
    destination.parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(
        prefix=f'.{destination.name}.tmp.', dir=destination.parent))
    logs = stage / 'logs'
    logs.mkdir()
    (stage / 'ros_logs').mkdir()
    bundle = stage / 'effective_config'
    metrics_path = stage / 'metrics.json'
    threshold_source = (
        Path(get_package_share_directory('araco_system_tests')) /
        'config/thresholds/gazebo_baseline_v0.yaml')
    shutil.copyfile(threshold_source, stage / 'thresholds.json')
    environment = os.environ.copy()
    environment['ROS_DOMAIN_ID'] = str(
        arguments.domain_id if arguments.domain_id is not None else 100 + os.getpid() % 100)
    environment['GZ_PARTITION'] = (
        f'araco_gate{gate}_{os.getpid()}_{int(time.time())}')
    environment['ROS_LOG_DIR'] = str(stage / 'ros_logs')
    started = time.monotonic()
    launch_command = [
        'ros2', 'launch', 'araco_bringup', 'gazebo.launch.py',
        f'profile:={arguments.profile}', f'runtime_bundle:={bundle}',
    ]
    outcomes = {}
    errors = []
    launch = None
    relay = None
    launch_escalated = False
    gazebo_stop_valid = False
    launch_stream = (logs / 'launch.log').open('w', encoding='utf-8')
    relay_stream = (logs / 'joint_state_relay.log').open('w', encoding='utf-8')
    try:
        if gate == 5:
            relay = subprocess.Popen(
                ['ros2', 'run', 'araco_system_tests',
                 'araco_joint_state_relay'],
                env=environment, text=True, stdout=relay_stream,
                stderr=subprocess.STDOUT, start_new_session=True)
        launch = subprocess.Popen(
            launch_command, env=environment, text=True, stdout=launch_stream,
            stderr=subprocess.STDOUT, start_new_session=True)
        deadline = time.monotonic() + 15.0
        while (time.monotonic() < deadline and
               not (bundle / 'manifest.json').is_file() and launch.poll() is None):
            time.sleep(0.05)
        if not (bundle / 'manifest.json').is_file():
            errors.append('runtime bundle was not emitted before launch exit/timeout')
            score = {'status': 'FAIL', 'checks': {}, 'metrics': {}}
            outcomes['scorer'] = {'return_code': None, 'not_started': True}
        else:
            scorer_executable = (
                'araco_gate5_score' if gate == 5 else
                'araco_gate4_score' if gate == 4 else
                'araco_gate3_score' if gate == 3 else 'araco_gate1_score')
            scorer_command = [
                'ros2', 'run', 'araco_system_tests', scorer_executable,
                '--bundle', str(bundle), '--thresholds', str(threshold_source),
                '--output', str(metrics_path), '--started-monotonic', str(started),
            ]
            if gate == 5:
                scorer_command = [
                    'ros2', 'run', 'araco_system_tests', scorer_executable,
                    '--output', str(metrics_path),
                ]
            for case_name in arguments.case_name or []:
                scorer_command.extend(['--case-name', case_name])
            outcomes['scorer'], _ = _run(
                scorer_command, environment, logs / 'scorer.log',
                timeout=240 if gate == 5 else 180 if gate == 4 else
                100 if gate == 3 else 50)
            if metrics_path.is_file():
                score = json.loads(metrics_path.read_text(encoding='utf-8'))
            else:
                score = {'status': 'FAIL', 'checks': {}, 'metrics': {}}
                errors.append('scorer did not emit metrics.json')

        backend_process_stopped = (
            gate == 5 and
            score.get('metrics', {}).get('backend_process_stopped') is True)
        if backend_process_stopped:
            outcomes['safety_shutdown'] = {
                'skipped': True,
                'reason': 'Gate 5 final scenario stopped required Gazebo process',
            }
            outcomes['gazebo_stop'] = {
                'skipped': True,
                'reason': 'Gazebo server already stopped by Gate 5 scorer',
            }
            shutdown_valid = True
            gazebo_stop_valid = True
        else:
            shutdown_command = [
                'ros2', 'action', 'send_goal', '/araco/safety/transition',
                'araco_interfaces/action/SafetyTransition', '{request: 4}',
            ]
            outcomes['safety_shutdown'], shutdown_text = _run(
                shutdown_command, environment, logs / 'safety_shutdown.log', timeout=10)
            shutdown_valid = (
                outcomes['safety_shutdown']['return_code'] == 0 and
                'accepted: true' in shutdown_text and 'final_state: 7' in shutdown_text)
            if not shutdown_valid:
                errors.append('orderly SafetyTransition shutdown was not accepted')
            gazebo_command = [
                'gz', 'service', '-s', '/server_control',
                '--reqtype', 'gz.msgs.ServerControl',
                '--reptype', 'gz.msgs.Boolean', '--timeout', '3000',
                '--req', 'stop: true',
            ]
            outcomes['gazebo_stop'], _ = _run(
                gazebo_command, environment, logs / 'gazebo_stop.log', timeout=5)
            gazebo_stop_valid = outcomes['gazebo_stop']['return_code'] == 0
    except Exception as error:  # preserve unexpected harness failures as evidence
        errors.append(f'evidence runner exception: {type(error).__name__}: {error}')
        score = {'status': 'FAIL', 'checks': {}, 'metrics': {}}
        shutdown_valid = False
    finally:
        if launch is not None:
            try:
                launch.wait(timeout=5)
            except subprocess.TimeoutExpired:
                launch_escalated = True
                os.killpg(launch.pid, signal.SIGINT)
                try:
                    launch.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(launch.pid, signal.SIGTERM)
                    launch.wait(timeout=5)
            outcomes['launch'] = {
                'command': launch_command,
                'return_code': launch.returncode,
                'wall_s': time.monotonic() - started,
                'escalated': launch_escalated,
            }
        if relay is not None:
            os.killpg(relay.pid, signal.SIGINT)
            try:
                relay.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(relay.pid, signal.SIGTERM)
                relay.wait(timeout=5)
            outcomes['joint_state_relay'] = {
                'command': [
                    'ros2', 'run', 'araco_system_tests',
                    'araco_joint_state_relay'],
                'return_code': relay.returncode,
            }
        launch_stream.close()
        relay_stream.close()

    launch_text = (logs / 'launch.log').read_text(encoding='utf-8')
    # Scoring must have completed before any shutdown error may be attributed
    # to the known upstream gz-sim defect; otherwise everything stays blocking.
    scored_complete = metrics_path.is_file()
    classification = classify_launch_log(
        launch_text, scored_complete, gazebo_stop_valid, launch_escalated)
    shutdown_defect = classification['shutdown_defect']
    log_clean = not classification['unclassified']
    if not log_clean:
        errors.append('launch log contains a traceback, process death, or ERROR record')
    launch_return_code = outcomes.get('launch', {}).get('return_code')
    # A non-zero launch exit caused solely by the recorded upstream shutdown
    # defect is not a gate failure; anything else still is.
    launch_valid = launch_return_code == 0 or bool(
        scored_complete and gazebo_stop_valid and shutdown_defect and log_clean)
    if not launch_valid:
        errors.append('launch did not exit cleanly')
    checks = {
        f'gate{gate}_score': score.get('status') == 'PASS',
        'orderly_safety_shutdown': shutdown_valid,
        'gazebo_stop_request': gazebo_stop_valid,
        'launch_exit': launch_valid,
        'launch_log_clean': log_clean,
    }
    upstream_defects = {
        'gz_sim_shutdown': {
            'observed': bool(shutdown_defect),
            'blocking': False,
            'reference': 'gz-sim 8.11.0 teardown with gz_ros2_control; '
                         'see .agent/WORKING_STATE.md Defect C',
            'launch_return_code': launch_return_code,
            'escalated': launch_escalated,
            'lines': shutdown_defect,
        },
    }
    if gate == 2:
        solver_path = bundle / 'normalized_artifacts/araco_kinematics_ik.json'
        params_path = bundle / 'node_params/locomotion.yaml'
        solver = (
            json.loads(solver_path.read_text(encoding='utf-8'))
            if solver_path.is_file() else {})
        params = (
            yaml.safe_load(params_path.read_text(encoding='utf-8'))
            if params_path.is_file() else {})
        locomotion = params.get('/araco/locomotion', {}).get('ros__parameters', {})
        checks.update({
            'analytic_ik_contract': (
                solver.get('data', {}).get('algorithm') ==
                'analytic-four-dof-position-and-foot-pitch' and
                solver.get('data', {}).get('foot_pitch_target_policy') ==
                'project_world_down_into_each_leg_sagittal_plane' and
                solver.get('data', {}).get('orientation_residual_policy') ==
                'report_rejected_angle' and
                solver.get('data', {}).get('failure_policy') ==
                'reject_complete_transaction' and
                solver.get('data', {}).get('standing_branch') == 'knee_down'),
            'typed_six_leg_standing_inputs': (
                len(locomotion.get('leg_geometry_m', [])) == 4 and
                len(locomotion.get('leg_mount_positions_base_m', [])) == 18 and
                len(locomotion.get('standing_foot_targets_base_m', [])) == 18 and
                len(locomotion.get('joint_lower_rad', [])) == 24 and
                len(locomotion.get('joint_upper_rad', [])) == 24),
            'computed_standing_commit_log': (
                'active in Gate 2 computed-standing mode' in launch_text),
        })
        if not all(checks[name] for name in (
                'analytic_ik_contract', 'typed_six_leg_standing_inputs',
                'computed_standing_commit_log')):
            errors.append('Gate 2 computed-standing contract was not proven')
    if gate == 3:
        params_path = bundle / 'node_params/locomotion.yaml'
        params = (
            yaml.safe_load(params_path.read_text(encoding='utf-8'))
            if params_path.is_file() else {})
        locomotion = params.get('/araco/locomotion', {}).get('ros__parameters', {})
        checks.update({
            'typed_body_pose_runtime_contract': (
                len(locomotion.get('joint_command_rate_cap_rad_s', [])) == 24 and
                locomotion.get('body_translation_rate_m_s') == 0.03 and
                locomotion.get('body_angular_rate_rad_s') == 0.3),
            'planted_foot_body_pose_log': (
                'Phase 4 planted-foot body-pose ready' in launch_text),
        })
        if not all(checks[name] for name in (
                'typed_body_pose_runtime_contract',
                'planted_foot_body_pose_log')):
            errors.append('Gate 3 planted-foot runtime contract was not proven')
    if gate == 4:
        params_path = bundle / 'node_params/locomotion.yaml'
        params = (
            yaml.safe_load(params_path.read_text(encoding='utf-8'))
            if params_path.is_file() else {})
        locomotion = params.get('/araco/locomotion', {}).get('ros__parameters', {})
        checks.update({
            'typed_tripod_runtime_contract': (
                locomotion.get('gait_base_cadence_hz') == 1.0 and
                locomotion.get('gait_maximum_cadence_hz') == 1.5 and
                locomotion.get('gait_cadence_rate_hz_s') == 1.0 and
                locomotion.get('gait_preferred_maximum_stride_scale') == 0.5 and
                locomotion.get('gait_motion_deadband_m_s') == 0.005 and
                locomotion.get('gait_duty_factor') == 0.5 and
                locomotion.get('gait_maximum_stride_m') == 0.06 and
                locomotion.get('gait_swing_clearance_m') == 0.03 and
                locomotion.get('stable_hold_dwell_s') == 0.25),
            'tripod_gait_log': (
                'Phase 5 tripod gait ready' in launch_text and
                'responsive cadence/stride scheduler ready' in launch_text),
        })
        if not all(checks[name] for name in (
                'typed_tripod_runtime_contract', 'tripod_gait_log')):
            errors.append('Gate 4 tripod-gait runtime contract was not proven')
    if gate == 5:
        checks.update({
            'typed_arbitration_status_log': (
                'safety transition state=' in launch_text and
                'Phase 5 tripod gait ready' in launch_text),
            'fault_matrix_complete': len(score.get('checks', {})) >= 20,
            'backend_process_loss_proven': (
                score.get('metrics', {}).get('backend_process_stopped') is True),
        })
        if not all(checks[name] for name in (
                'typed_arbitration_status_log', 'fault_matrix_complete',
                'backend_process_loss_proven')):
            errors.append('Gate 5 supervision/fault matrix was not proven')
    status = 'PASS' if all(checks.values()) else 'FAIL'
    manifest = (
        json.loads((bundle / 'manifest.json').read_text(encoding='utf-8'))
        if (bundle / 'manifest.json').is_file() else {})
    _write_json(stage / 'environment.json', _environment(environment))
    _write_json(stage / 'process_outcomes.json', outcomes)
    _write_json(stage / 'validation_report.json', {
        'status': status, 'checks': checks, 'errors': errors,
        'upstream_defects': upstream_defects})
    _write_json(stage / 'gate_result.json', {
        'gate': gate,
        'status': status,
        'profile': arguments.profile,
        'run_fingerprint': manifest.get('run_fingerprint'),
        'behavior_fingerprint': manifest.get('behavior_fingerprint'),
        'upstream_defects': upstream_defects,
        'metrics': score.get('metrics', {}),
    })
    _junit(
        stage / 'junit.xml', gate, checks,
        '; '.join(errors) or f'Gate {gate} check failed')
    os.replace(stage, destination)
    print(f'Gate {gate} {status}: {destination}')
    raise SystemExit(0 if status == 'PASS' else 1)


if __name__ == '__main__':
    main()
