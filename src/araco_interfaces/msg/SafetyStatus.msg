# Software safety states. These are independent of ROS lifecycle state.
uint8 STATE_INITIALIZING=0
uint8 STATE_INACTIVE=1
uint8 STATE_HOLDING=2
uint8 STATE_ENABLING=3
uint8 STATE_MOTION_ENABLED=4
uint8 STATE_STOPPING=5
uint8 STATE_FAULT_HOLD=6
uint8 STATE_SHUTTING_DOWN=7

# Readiness bits. Physical-only readiness must not be asserted by a simulator.
uint64 READY_MODEL=1
uint64 READY_BACKEND=2
uint64 READY_JOINT_STATE=4
uint64 READY_CONTROLLERS=8
uint64 READY_LOCOMOTION=16
uint64 READY_PROVENANCE=32
uint64 READY_TIME=64
uint64 READY_HARDWARE_CALIBRATION=128
uint64 READY_POWER=256
uint64 READY_LOCAL_STOP_INPUT=512

# Fault-category bits.
uint64 FAULT_SELECTED_COMMAND_STREAM=1
uint64 FAULT_LOCOMOTION=2
uint64 FAULT_CONTROLLER=4
uint64 FAULT_JOINT_STATE=8
uint64 FAULT_KINEMATICS=16
uint64 FAULT_BACKEND=32
uint64 FAULT_TIME=64
uint64 FAULT_INTERNAL=128
uint64 FAULT_SOFTWARE_LATCH=256
uint64 FAULT_POWER=512
uint64 FAULT_SERIAL=1024

# Common reason-code allocation shared by safety and locomotion interfaces.
uint16 REASON_NONE=0
uint16 REASON_STARTUP=1
uint16 REASON_INACTIVE=2
uint16 REASON_HOLDING=3
uint16 REASON_WAITING_FOR_SOURCE=4
uint16 REASON_MANUAL_HOLD=5
uint16 REASON_NO_SOURCE=6
uint16 REASON_SOURCE_RELEASED=7
uint16 REASON_SOURCE_STALE=8
uint16 REASON_SOURCE_HANDOVER=9
uint16 REASON_SOURCE_INVALID=10
uint16 REASON_COMMAND_LIMITED=11
uint16 REASON_SELECTED_COMMAND_STALE=12
uint16 REASON_SAFE_COMMAND_STALE=13
uint16 REASON_LOCOMOTION_NOT_READY=14
uint16 REASON_LOCOMOTION_STALE=15
uint16 REASON_KINEMATICS_INVALID=16
uint16 REASON_JOINT_LIMIT=17
uint16 REASON_JOINT_STATE_STALE=18
uint16 REASON_JOINT_STATE_INVALID=19
uint16 REASON_CONTROLLER_NOT_READY=20
uint16 REASON_CONTROLLER_FAULT=21
uint16 REASON_BACKEND_FAULT=22
uint16 REASON_TIME_DISCONTINUITY=23
uint16 REASON_SHUTDOWN_REQUESTED=24
uint16 REASON_SOFTWARE_LATCHED_HOLD=25
uint16 REASON_RESET_REQUIRED=26
uint16 REASON_INTERNAL_ERROR=27
uint16 REASON_POWER_WARNING=28
uint16 REASON_POWER_CRITICAL=29
uint16 REASON_SERIAL_FAULT=30

std_msgs/Header header
uint64 safety_epoch
uint8 state
uint8 disposition
uint16 reason_code
uint32 selected_source_id
uint64 readiness_mask
uint64 required_readiness_mask
uint64 fault_mask
bool reset_required
