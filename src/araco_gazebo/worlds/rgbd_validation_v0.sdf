        <visual name="c26"><pose>3.432 0.84 0.82 0 0 0</pose><geometry><box><size>0.018 0.28 0.26</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Four distinct geometry/color signatures make every side recognizable. -->
    <model name="red_gate">
      <static>true</static>
      <pose>1.65 1.55 0 0 0 -0.35</pose>
      <link name="gate_link">
        <collision name="left_post_collision"><pose>0 0.38 0.45 0 0 0</pose><geometry><box><size>0.18 0.18 0.9</size></box></geometry></collision>
        <collision name="right_post_collision"><pose>0 -0.38 0.45 0 0 0</pose><geometry><box><size>0.18 0.18 0.9</size></box></geometry></collision>
        <collision name="top_collision"><pose>0 0 0.92 0 0 0</pose><geometry><box><size>0.22 0.94 0.16</size></box></geometry></collision>
        <visual name="left_post"><pose>0 0.38 0.45 0 0 0</pose><geometry><box><size>0.18 0.18 0.9</size></box></geometry><material><ambient>0.76 0.02 0.02 1</ambient><diffuse>0.95 0.03 0.02 1</diffuse></material></visual>
        <visual name="right_post"><pose>0 -0.38 0.45 0 0 0</pose><geometry><box><size>0.18 0.18 0.9</size></box></geometry><material><ambient>0.76 0.02 0.02 1</ambient><diffuse>0.95 0.03 0.02 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 0.92 0 0 0</pose><geometry><box><size>0.22 0.94 0.16</size></box></geometry><material><ambient>0.96 0.48 0.02 1</ambient><diffuse>1.0 0.62 0.02 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cyan_steps">
      <static>true</static>
      <pose>-1.70 1.55 0 0 0 0.55</pose>
      <link name="steps_link">
        <collision name="step1_collision"><pose>0 0 0.14 0 0 0</pose><geometry><box><size>0.55 0.55 0.28</size></box></geometry></collision>
        <collision name="step2_collision"><pose>0.14 0 0.42 0 0 0</pose><geometry><box><size>0.42 0.55 0.28</size></box></geometry></collision>
        <collision name="step3_collision"><pose>0.25 0 0.70 0 0 0</pose><geometry><box><size>0.20 0.55 0.28</size></box></geometry></collision>
        <visual name="step1"><pose>0 0 0.14 0 0 0</pose><geometry><box><size>0.55 0.55 0.28</size></box></geometry><material><ambient>0.01 0.55 0.70 1</ambient><diffuse>0.01 0.78 0.96 1</diffuse></material></visual>
        <visual name="step2"><pose>0.14 0 0.42 0 0 0</pose><geometry><box><size>0.42 0.55 0.28</size></box></geometry><material><ambient>0.01 0.42 0.66 1</ambient><diffuse>0.01 0.60 0.90 1</diffuse></material></visual>
        <visual name="step3"><pose>0.25 0 0.70 0 0 0</pose><geometry><box><size>0.20 0.55 0.28</size></box></geometry><material><ambient>0.01 0.30 0.56 1</ambient><diffuse>0.01 0.44 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="magenta_totem">
      <static>true</static>
      <pose>-1.55 -1.70 0 0 0 0</pose>
      <link name="totem_link">
        <collision name="base_collision"><pose>0 0 0.16 0 0 0</pose><geometry><cylinder><radius>0.34</radius><length>0.32</length></cylinder></geometry></collision>
        <collision name="stem_collision"><pose>0 0 0.58 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>0.58</length></cylinder></geometry></collision>
        <collision name="head_collision"><pose>0 0 0.96 0 0 0</pose><geometry><sphere><radius>0.25</radius></sphere></geometry></collision>
        <visual name="base"><pose>0 0 0.16 0 0 0</pose><geometry><cylinder><radius>0.34</radius><length>0.32</length></cylinder></geometry><material><ambient>0.45 0.01 0.56 1</ambient><diffuse>0.68 0.01 0.84 1</diffuse></material></visual>
        <visual name="stem"><pose>0 0 0.58 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>0.58</length></cylinder></geometry><material><ambient>0.78 0.02 0.62 1</ambient><diffuse>0.96 0.02 0.78 1</diffuse></material></visual>
        <visual name="head"><pose>0 0 0.96 0 0 0</pose><geometry><sphere><radius>0.25</radius></sphere></geometry><material><ambient>0.93 0.18 0.68 1</ambient><diffuse>1.0 0.28 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="yellow_pillars">
      <static>true</static>
      <pose>1.75 -1.60 0 0 0 0.42</pose>
      <link name="pillars_link">
        <collision name="tall_collision"><pose>0 0.24 0.48 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.96</length></cylinder></geometry></collision>
        <collision name="short_collision"><pose>0 -0.24 0.30 0 0 0</pose><geometry><cylinder><radius>0.24</radius><length>0.60</length></cylinder></geometry></collision>
        <visual name="tall"><pose>0 0.24 0.48 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.96</length></cylinder></geometry><material><ambient>0.92 0.58 0.01 1</ambient><diffuse>1.0 0.75 0.02 1</diffuse></material></visual>
        <visual name="short"><pose>0 -0.24 0.30 0 0 0</pose><geometry><cylinder><radius>0.24</radius><length>0.60</length></cylinder></geometry><material><ambient>0.76 0.42 0.01 1</ambient><diffuse>0.96 0.55 0.01 1</diffuse></material></visual>
        <visual name="stripe"><pose>-0.005 0.24 0.62 0 0 0</pose><geometry><cylinder><radius>0.184</radius><length>0.10</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Offset wall relief adds parallax/depth edges around the loop. -->
    <model name="wall_relief">
      <static>true</static>
      <link name="relief_link">
        <visual name="north_bar1"><pose>-2.2 3.40 0.35 0 0 0</pose><geometry><box><size>0.22 0.16 0.70</size></box></geometry><material><ambient>0.03 0.25 0.72 1</ambient><diffuse>0.03 0.34 0.94 1</diffuse></material></visual>
        <visual name="north_bar2"><pose>-1.75 3.36 0.52 0 0 0</pose><geometry><box><size>0.18 0.24 1.04</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="north_bar3"><pose>-1.30 3.39 0.24 0 0 0</pose><geometry><box><size>0.30 0.18 0.48</size></box></geometry><material><ambient>0.03 0.25 0.72 1</ambient><diffuse>0.03 0.34 0.94 1</diffuse></material></visual>
        <visual name="south_red"><pose>1.95 -3.38 0.40 0 0 0</pose><geometry><box><size>0.60 0.20 0.80</size></box></geometry><material><ambient>0.74 0.03 0.03 1</ambient><diffuse>0.94 0.04 0.03 1</diffuse></material></visual>
        <visual name="south_white"><pose>1.25 -3.39 0.64 0 0 0</pose><geometry><box><size>0.30 0.18 0.46</size></box></geometry><material><ambient>0.96 0.96 0.96 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="west_green1"><pose>-3.39 1.85 0.34 0 0 0</pose><geometry><box><size>0.18 0.32 0.68</size></box></geometry><material><ambient>0.02 0.62 0.22 1</ambient><diffuse>0.02 0.82 0.28 1</diffuse></material></visual>
        <visual name="west_green2"><pose>-3.36 1.30 0.58 0 0 0</pose><geometry><box><size>0.24 0.20 1.00</size></box></geometry><material><ambient>0.02 0.42 0.18 1</ambient><diffuse>0.02 0.62 0.24 1</diffuse></material></visual>
