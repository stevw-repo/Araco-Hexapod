<sdf version="1.10">
  <world name="araco_rgbd_validation">
    <physics name="dart_1000hz" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <scene>
      <ambient>0.38 0.40 0.44 1</ambient>
      <background>0.58 0.68 0.82 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.1</intensity>
      <direction>-0.45 0.25 -0.86</direction>
      <diffuse>0.96 0.93 0.86 1</diffuse>
      <specular>0.24 0.24 0.28 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material>
            <ambient>0.48 0.50 0.52 1</ambient>
            <diffuse>0.58 0.60 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Thin visual-only floor marks provide RGB features without changing contact. -->
    <model name="floor_markers">
      <static>true</static>
      <link name="markers_link">
        <visual name="north_blue"><pose>0 2.55 0.002 0 0 0</pose><geometry><box><size>1.2 0.18 0.004</size></box></geometry><material><ambient>0.02 0.30 0.78 1</ambient><diffuse>0.02 0.38 0.95 1</diffuse></material></visual>
        <visual name="east_red"><pose>2.55 0 0.002 0 0 0</pose><geometry><box><size>0.18 1.2 0.004</size></box></geometry><material><ambient>0.82 0.04 0.04 1</ambient><diffuse>0.96 0.06 0.04 1</diffuse></material></visual>
        <visual name="south_yellow"><pose>0 -2.55 0.002 0 0 0</pose><geometry><box><size>1.2 0.18 0.004</size></box></geometry><material><ambient>0.85 0.58 0.02 1</ambient><diffuse>1.0 0.72 0.02 1</diffuse></material></visual>
        <visual name="west_green"><pose>-2.55 0 0.002 0 0 0</pose><geometry><box><size>0.18 1.2 0.004</size></box></geometry><material><ambient>0.02 0.60 0.24 1</ambient><diffuse>0.02 0.82 0.32 1</diffuse></material></visual>
        <visual name="route_corner_ne"><pose>2.45 2.45 0.003 0 0 0.785398</pose><geometry><box><size>0.55 0.14 0.006</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="route_corner_sw"><pose>-2.45 -2.45 0.003 0 0 0.785398</pose><geometry><box><size>0.55 0.14 0.006</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
        <visual name="acceptance_east"><pose>1.2 0 0.003 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.006</length></cylinder></geometry><material><ambient>0.82 0.04 0.04 1</ambient><diffuse>0.96 0.06 0.04 1</diffuse></material></visual>
        <visual name="acceptance_north"><pose>0 1.2 0.003 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.006</length></cylinder></geometry><material><ambient>0.02 0.30 0.78 1</ambient><diffuse>0.02 0.38 0.95 1</diffuse></material></visual>
        <visual name="acceptance_west"><pose>-1.2 0 0.003 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.006</length></cylinder></geometry><material><ambient>0.02 0.60 0.24 1</ambient><diffuse>0.02 0.82 0.32 1</diffuse></material></visual>
        <visual name="acceptance_south"><pose>0 -1.2 0.003 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.006</length></cylinder></geometry><material><ambient>0.85 0.58 0.02 1</ambient><diffuse>1.0 0.72 0.02 1</diffuse></material></visual>
        <visual name="acceptance_origin"><pose>0 0 0.003 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.006</length></cylinder></geometry><material><ambient>0.90 0.90 0.90 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <!-- White chevron points along the required start / +X body heading. -->
        <visual name="start_heading_shaft"><pose>0.45 0 0.007 0 0 0</pose><geometry><box><size>0.78 0.055 0.008</size></box></geometry><material><ambient>0.98 0.98 0.98 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="start_heading_left"><pose>0.76 0.105 0.007 0 0 -0.72</pose><geometry><box><size>0.32 0.055 0.008</size></box></geometry><material><ambient>0.98 0.98 0.98 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="start_heading_right"><pose>0.76 -0.105 0.007 0 0 0.72</pose><geometry><box><size>0.32 0.055 0.008</size></box></geometry><material><ambient>0.98 0.98 0.98 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="arena_walls">
      <static>true</static>
      <link name="walls_link">
        <collision name="east_collision"><pose>3.5 0 0.65 0 0 0</pose><geometry><box><size>0.12 7.12 1.3</size></box></geometry></collision>
        <collision name="west_collision"><pose>-3.5 0 0.65 0 0 0</pose><geometry><box><size>0.12 7.12 1.3</size></box></geometry></collision>
        <collision name="north_collision"><pose>0 3.5 0.65 0 0 0</pose><geometry><box><size>7.12 0.12 1.3</size></box></geometry></collision>
        <collision name="south_collision"><pose>0 -3.5 0.65 0 0 0</pose><geometry><box><size>7.12 0.12 1.3</size></box></geometry></collision>
        <visual name="east_wall"><pose>3.5 0 0.65 0 0 0</pose><geometry><box><size>0.12 7.12 1.3</size></box></geometry><material><ambient>0.72 0.72 0.74 1</ambient><diffuse>0.80 0.80 0.82 1</diffuse></material></visual>
        <visual name="west_wall"><pose>-3.5 0 0.65 0 0 0</pose><geometry><box><size>0.12 7.12 1.3</size></box></geometry><material><ambient>0.62 0.66 0.72 1</ambient><diffuse>0.70 0.75 0.82 1</diffuse></material></visual>
        <visual name="north_wall"><pose>0 3.5 0.65 0 0 0</pose><geometry><box><size>7.12 0.12 1.3</size></box></geometry><material><ambient>0.72 0.68 0.62 1</ambient><diffuse>0.82 0.77 0.70 1</diffuse></material></visual>
        <visual name="south_wall"><pose>0 -3.5 0.65 0 0 0</pose><geometry><box><size>7.12 0.12 1.3</size></box></geometry><material><ambient>0.68 0.70 0.64 1</ambient><diffuse>0.77 0.80 0.70 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Front checkerboard: immediately visible from the nominal +X camera view. -->
    <model name="east_checkerboard">
      <static>true</static>
      <link name="checker_link">
        <visual name="c00"><pose>3.432 -0.84 0.30 0 0 0</pose><geometry><box><size>0.018 0.28 0.26</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
