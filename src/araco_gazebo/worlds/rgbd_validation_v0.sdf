        <visual name="c22"><pose>3.432 -0.28 0.82 0 0 0</pose><geometry><box><size>0.018 0.28 0.26</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
