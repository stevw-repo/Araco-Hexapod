        <visual name="c06"><pose>3.432 0.84 0.30 0 0 0</pose><geometry><box><size>0.018 0.28 0.26</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
        <visual name="c10"><pose>3.432 -0.84 0.56 0 0 0</pose><geometry><box><size>0.018 0.28 0.26</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
